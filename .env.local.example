# Get these from Supabase Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. Get from Supabase Project Settings > API > service_role (secret).
# REQUIRED for sending authentication emails — without this, the verification
# code email never gets sent.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# EmailJS (the single email path — see lib/email.ts)
# These three are PUBLIC BY DESIGN (they ship to the browser), so they are
# safe to put in NEXT_PUBLIC_* variables. Create an EmailJS account, then one
# service + one template. The template must accept: {{to_email}},
# {{subject}}, {{html_content}}.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=service_your_service_id
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=template_your_template_id
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_public_key